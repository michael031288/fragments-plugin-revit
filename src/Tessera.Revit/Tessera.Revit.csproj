<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Tessera.Revit</RootNamespace>
    <AssemblyName>Tessera.Revit</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\$(RevitVersion)\</OutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <Rhino3dmVersion>8.35.0</Rhino3dmVersion>
  </PropertyGroup>

  <Target Name="RejectUnsupportedRevit" BeforeTargets="Restore">
    <Error Condition="$(RevitVersion) &lt; 2025" Text="Tessera.Revit targets Revit 2025 and newer, which run on .NET 8." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
    <ProjectReference Include="..\Tessera.Core\Tessera.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Tessera.Revit.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyRhinoNative" AfterTargets="Build">
    <PropertyGroup>
      <_RhinoNative>$(NuGetPackageRoot)rhino3dm\$(Rhino3dmVersion)\runtimes\win-x64\native\librhino3dm_native.dll</_RhinoNative>
    </PropertyGroup>
    <Error Condition="!Exists('$(_RhinoNative)')" Text="Could not find librhino3dm_native.dll at $(_RhinoNative). Restore the Rhino3dm package first." />
    <Copy SourceFiles="$(_RhinoNative)" DestinationFiles="$(OutputPath)librhino3dm_native.dll" SkipUnchangedFiles="true" />
    <RemoveDir Directories="$(OutputPath)runtimes" />
  </Target>
</Project>
